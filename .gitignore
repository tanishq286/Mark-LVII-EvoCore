# ── MARK LVI — what never belongs in the repository ──────────────────────────
# Everything listed here is created by the app on first run. A fresh clone with
# none of it present boots straight to the setup screen, which is the intended
# first experience — so nothing here needs to be committed, and some of it must
# never be.

# ── Secrets. Committing any of these publishes them. ──────────────────────────
# Note: gitignore does NOT strip inline # comments — keep patterns on clean lines!
# your Gemini API key, plus per-plugin credentials
config/api_keys.json
# local private MCP server definitions (template tracked in config/mcp_servers.example.json)
config/mcp_servers.json
# the dashboard's TLS private key and certificate
config/certs/
memory/certs/
# a LINKED WhatsApp session — committing it hands somebody your WhatsApp account
config/whatsapp_web/
# Google OAuth tokens & client secrets (Gmail / Calendar plugins)
**/token*.json
**/client_secret*.json
*credentials*.json
.env
.env.*

# ── Personal data the assistant accumulates about you ─────────────────────────
memory/long_term.json
memory/routines.json
memory/tasks/
memory/ecosystem_index.json
memory/linux_wsl_deep_knowledge.json
memory/epistemic_graph.json
memory/heuristics_chain.json
memory/score_history.json
memory/evolution_journal.json
memory/failure_patterns.json
memory/goddess_mind.json
memory/antigravity_*.json
memory/antigravity_backups/
.jarvis_backup/
memory/habits.json
memory/evolution_digest.json
memory/evolution_commits.json
memory/vault_index.json
memory/autonomous_missions.json
memory/voiceprints.json
memory/project_profiles.json
memory/form_profile.jvault
memory/.spotify_cache
memory/android_devices.json
memory/*.log
memory/*.db
memory/*.sqlite
memory/*.sqlite-wal
memory/*.sqlite-shm
.pytest_cache/
training_data/
generated_sites/
knowledge/
backups/
reports/
UPGRADE_PROGRESS.md
config/project_briefs/
providers/voices/

# ── Python build noise ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.bak
*.bak-*
*.tmp
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
.venv-train/
venv/
env/
ENV/

# ── Editors and operating systems ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Runtime output ────────────────────────────────────────────────────────────
*.log
logs/
downloads/
screenshots/

# ── Android companion build artifacts & keystores ─────────────────────────────
android_companion/.gradle/
android_companion/build/
android_companion/app/build/
android_companion/local.properties
android_companion/.idea/
*.keystore
*.jks
*.apk
*.aab
memory/agents_state.json
memory/upgrade_snapshots/
